# ==============================================================================
# APEX DETAILING - TURNKEY CLIENT TEMPLATE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development or set these variables
# directly in Vercel Project Settings > Environment Variables.

# 1. RESEND EMAIL INTEGRATION (Automated Booking Confirmations)
# Generate from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"

# The verified sender email address on your domain (e.g. "booking@yourdomain.com")
# Or use "Apex Detailing <onboarding@resend.dev>" during testing / domain verification.
RESEND_FROM_EMAIL="Apex Detailing <booking@yourdomain.com>"

# The client/artisan email where incoming customer appointment requests are delivered
ARTISAN_EMAIL="artisan@example.com"

# 2. ADMIN EDITOR (/admin)
# Password the client types to open the visual editor.
ADMIN_PASSWORD="choose-a-long-password"
# Random string (32+ chars) used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="replace-with-a-long-random-string"

# 3. PUBLISH BUTTON (GitHub -> Vercel)
# Fine-grained token limited to this repository, permission "Contents: Read and write".
# https://github.com/settings/personal-access-tokens/new
# Leave empty in local dev: "Publier" then writes the files straight to disk.
GITHUB_TOKEN=""
# owner/repo of this site, and the branch Vercel deploys to production.
GITHUB_REPO="mahdi2983/template"
GITHUB_BRANCH="main"

# 4. PUBLIC WEBSITE URL
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
